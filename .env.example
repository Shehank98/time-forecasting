# --- Database (client workspaces, users, saved forecasts and reports) ---
# Railway: add the PostgreSQL plugin and set DATABASE_URL=${{Postgres.DATABASE_URL}}
# Left empty, a local SQLite file at data/app.db is used (fine for a laptop, not for Railway).
DATABASE_URL=

# --- First admin (created only when the users table is empty) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Gemini (server side only, never sent to the browser) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- TimesFM ---
# Hugging Face cache for the checkpoint. Docker default /opt/hf is baked into the image.
HF_HOME=/opt/hf
# 1 = load TimesFM in the background at startup, 0 = load on first forecast
PRELOAD_MODEL=1
# 1 = never load TimesFM, always use the statistical fallback (quick local development)
FORCE_FALLBACK=0
# Longest history fed to the model, in periods (1024 covers 3 years of daily data)
TIMESFM_MAX_CONTEXT=1024

# --- App ---
MAX_UPLOAD_MB=25
LOGIN_DAYS=7
LOG_LEVEL=INFO
PORT=8000
