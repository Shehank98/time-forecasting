# Required for AI insights and chat. Server side only, never sent to the browser.
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
# Where the TimesFM checkpoint is cached. Docker default /opt/hf is baked into the image.
# With a Railway volume mounted at /data use: HF_HOME=/data/hf
HF_HOME=/opt/hf
# Upload size limit in MB
MAX_UPLOAD_MB=25
# Railway sets PORT automatically. Local default 8000.
PORT=8000
# Minutes an idle session (and its uploaded data) is kept in memory
SESSION_TTL_MIN=120
# 1 = load TimesFM in the background at startup, 0 = load on first forecast
PRELOAD_MODEL=1
# 1 = never load TimesFM, always use the statistical fallback (handy for local development)
FORCE_FALLBACK=0
LOG_LEVEL=INFO
# Optional: require this token (header X-Admin-Token) to edit settings from the UI. Strongly recommended on a public URL.
ADMIN_TOKEN=
# Maximum sessions kept in memory (least recently used are dropped first)
MAX_SESSIONS=200
